# Copy this to .env for local dev (Railway: set these in the project's Variables tab instead)

# Local: sqlite:///./lodha.db
# Railway with a volume: sqlite:////data/lodha.db
DATABASE_URL=sqlite:///./lodha.db

# Shared secret Vapi sends on every function/webhook call — set the same value in Vapi's dashboard
VAPI_SHARED_SECRET=your-own-random-string-here

# Token the dashboard sends as "Authorization: Bearer <this>"
DASHBOARD_TOKEN=another-random-string-here

# Comma-separated list of allowed origins for CORS, e.g. https://your-dashboard.vercel.app
ALLOWED_ORIGINS=*

# Set once your n8n workflow is ready (see app/routers/vapi.py call_ended handler)
N8N_WEBHOOK_URL=
